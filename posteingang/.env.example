# Vorlage für posteingang/.env (echte Werte nur in .env, chmod 600, nie ins Repo)
#   cp .env.example .env && chmod 600 .env

# Privates Postfach jan@kleinke.org bei All-Inkl (KAS), nur lesend per IMAP
# Nutzer: meist die volle Adresse, sonst die Postfach-Kennung aus KAS (m0...)
IMAP_HOST=w005718f.kasserver.com
IMAP_PORT=993
IMAP_NUTZER=jan@kleinke.org
IMAP_KENNWORT=

# Mails senden (Stufe 2, nur nach Freigabe, agentkit.mail): All-Inkl SMTP mit SSL, gleicher Login wie IMAP
SMTP_HOST=w005718f.kasserver.com
SMTP_PORT=465
MAIL_ABSENDER=jan@kleinke.org
MAIL_NAME=Jan Kleinke
# Ordner für die Kopie gesendeter Mails und für die Suche nach Jans Schreibstil
GESENDET_ORDNER=Sent
