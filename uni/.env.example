# Vorlage für uni/.env (echte Werte nur in .env, chmod 600, nie ins Repo)

# HNEE-Konto (gilt für Moodle und Mail), z. B. hmuster oder u12345
HNEE_NUTZER=
HNEE_KENNWORT=

# Moodle (Login wie die Moodle-App, ohne Browser)
MOODLE_URL=https://lms.hnee.de

# Unipostfach (Exchange der HNEE, per IMAP)
IMAP_HOST=mail.hnee.de
IMAP_PORT=993
