# Zugangsdaten: niemals ins Repo
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
token*.json
cookies*

# Python
.venv/
venv/
__pycache__/
*.pyc

# Node
node_modules/

# Laufzeitdaten der Agenten (Datenbanken, Downloads, Logs, Browser-Profile)
data/
logs/
*.log
*.db
*.sqlite
browser-profile/

# Freigabe-Warteschlange: Entwürfe können persönliche Inhalte enthalten
shared/freigabe/offen/
shared/freigabe/erledigt/

# Editor
.vscode/
.DS_Store

# Auftrags-Warteschlange: Aufträge können persönliche Inhalte enthalten
shared/auftraege/neu/
shared/auftraege/erledigt/

# Verbrauchsprotokoll der claude-Läufe
shared/verbrauch/

# Ereignisse für den Leitstand (agentkit.ereignis): nur IDs und Zahlen, trotzdem nicht ins Repo
shared/ereignisse/

# Meldungen an Jan: können persönliche Inhalte enthalten
shared/meldungen/

# Stand der Ausfallmeldungen (agentkit.ausfall)
shared/ausfall/

# Lias Instanz (AGENTKIT_INSTANZ=lia/instanz): Warteschlangen, Verbrauch, Ausfallstand
lia/instanz/freigabe/
lia/instanz/auftraege/
lia/instanz/meldungen/
lia/instanz/verbrauch/
lia/instanz/ausfall/
