# Vorlage für kleinanzeigen/.env (echte Werte nur in .env, chmod 600, nie ins Repo)
#   cp .env.example .env && chmod 600 .env
# Wird NUR aus dieser Datei gelesen, nicht aus shared/.env (dort steht der Token der Zentrale).

# Eigener Bot von @BotFather (nicht den Token der Zentrale oder des Vinted-Bots verwenden)
TELEGRAM_BOT_TOKEN=
# Wer den Bot nutzen darf: Chat-IDs mit Komma getrennt (Jan, Kumpel).
# Die eigene ID nennt der Bot, wenn man ihm /start schickt.
ERLAUBTE_CHAT_IDS=
# Alle so viele Minuten neue Anzeigen holen (Abruf kostet nichts, Claude nur bei neuen Kandidaten)
TAKT_MIN=5
# Höchstens so viele Claude-Läufe pro Tag (beide Nutzer zusammen), danach nur klare Schnäppchen ohne Claude
TAGESGRENZE=100
# Ab so vielen Punkten (0-100) kommt eine Meldung
MELDE_SCHWELLE=70
# Nachtruhe von-bis Uhr (keine Abrufe), 0-0 = keine
NACHTRUHE=1-6
