# Vorlage für finance/.env (nur Namen, keine Werte). Die echte .env mit chmod 600, nie ins Repo.
# Destatis GENESIS: entweder Token oder Benutzer+Passwort
GENESIS_TOKEN=
GENESIS_BENUTZER=
GENESIS_PASSWORT=

# UN Comtrade (Primary key)
COMTRADE_KEY=

# EPO OPS (developers.epo.org, My Apps: Consumer Key und Consumer Secret)
EPO_OPS_KEY=
EPO_OPS_SECRET=
