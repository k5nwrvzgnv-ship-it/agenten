+def nutrients(data: dict) -> dict | None:
+    """Naehrstoffe aus Claudes Antwort. None, wenn etwas fehlt oder unlesbar ist: dann wird nicht bewertet."""
+    try:
+        return {k: max(0.0, float(data[k])) for k in NUTRIENT_KEYS}
+    except (KeyError, TypeError, ValueError):
+        return None
+
+
+def fmt(x: float) -> str:
+    return f"{x:.0f}" if x >= 10 or x == int(x) else f"{x:.1f}".replace(".", ",")
+
+
+def amounts(data: dict) -> dict:
+    """Schaetzwerte je Katalogeintrag aus Claudes Antwort, Unlesbares bleibt weg."""
+    raw = data.get("amounts")
+    raw = dict(raw) if isinstance(raw, dict) else {}
+    raw.update(fiber=data.get("fiber_g"), veg=data.get("veg_g"))
+    out = {}
+    for key in CATALOG:
+        try:
+            out[key] = max(0.0, float(raw[key]))
+        except (KeyError, TypeError, ValueError):
+            pass
+    return out
+
+
+def get_selection(user_id) -> dict:
+    with db() as con:
+        row = con.execute("SELECT selection FROM nutrient_prefs WHERE user_id=?", (user_id,)).fetchone()
+    if not row:
+        return dict(DEFAULT_SELECTION)
+    sel = json.loads(row["selection"])
+    return {k: sel[k] for k in CATALOG if k in sel}
+
+
+def set_selection(user_id, sel: dict):
+    with db() as con:
+        con.execute(
+            "INSERT INTO nutrient_prefs(user_id,selection) VALUES(?,?) "
+            "ON CONFLICT(user_id) DO UPDATE SET selection=excluded.selection",
+            (user_id, json.dumps(sel)),
+        )
+
+
+def selected_goals(user_id) -> dict:
+    """Ausgewaehlte Naehrstoffe mit Tagesziel: eigenes Ziel, sonst Richtwert nach Geschlecht im Profil."""
+    col = 2 if get_profile(user_id)["sex"].startswith("m") else 3
+    return {k: goal or CATALOG[k][col] for k, goal in get_selection(user_id).items()}
+
+
+def day_amounts(user_id, day) -> dict:
+    """Tagessumme je Naehrstoff, nur aus Eintraegen mit Angaben dazu."""
+    with db() as con:
+        rows = con.execute(
+            "SELECT amounts FROM meals WHERE user_id=? AND day=? AND amounts IS NOT NULL", (user_id, day)
+        ).fetchall()
+    total = {}
+    for row in rows:
+        for k, v in json.loads(row["amounts"]).items():
+            total[k] = total.get(k, 0) + v
+    return total
+
+
+def complete_amounts(user_id, day) -> dict:
+    """Wie day_amounts, aber nur Naehrstoffe, die jeder Eintrag des Tages angibt. Fehlendes zaehlt nicht als 0."""
+    with db() as con:
+        rows = con.execute("SELECT amounts FROM meals WHERE user_id=? AND day=?", (user_id, day)).fetchall()
+    meals = [json.loads(r["amounts"] or "{}") for r in rows]
+    return {k: sum(m[k] for m in meals) for k in CATALOG if meals and all(k in m for m in meals)}
+
+
+def meal_amounts_line(user_id, data: dict) -> str:
+    """Feste Angabe je Mahlzeit. Ballaststoffe und Obst/Gemuese stehen schon in der Sternzeile."""
+    a = amounts(data)
+    parts = []
+    for k, goal in selected_goals(user_id).items():
+        if k in ("fiber", "veg"):
+            continue
+        name, unit = CATALOG[k][:2]
+        parts.append(f"{name} {fmt(a[k])} {unit} ({a[k] / goal:.0%})" if k in a else f"{name} ?")
+    return "~ " + ", ".join(parts) if parts else ""
+
+
+def amount_lines(user_id, day) -> list[str]:
+    a = day_amounts(user_id, day)
+    if not a:
+        return []
+    return [f"{CATALOG[k][0]}: {bar(a.get(k, 0), goal)} {fmt(a.get(k, 0))} / {fmt(goal)} {CATALOG[k][1]}"
+            for k, goal in selected_goals(user_id).items()]
+
+
+def amount_summary(user_id, days: list[str]) -> list[str]:
+    """Schnitt der ausgewaehlten Naehrstoffe, nur Tage mit vollstaendigen Angaben. Zaehlt nicht in die Punkte."""
+    per_day = [complete_amounts(user_id, d) for d in days]
+    lines, low = [], []
+    for k, goal in selected_goals(user_id).items():
+        values = [x[k] for x in per_day if k in x]
+        if not values:
+            continue
+        avg = sum(values) / len(values)
+        n = f"{len(values)} {'Tag' if len(values) == 1 else 'Tage'}"
+        lines.append(f"- {CATALOG[k][0]}: {fmt(avg)} / {fmt(goal)} {CATALOG[k][1]} ({n})")
+        if avg < 0.6 * goal:
+            low.append(CATALOG[k][0])
+    if not lines:
+        return []
+    lines.insert(0, "Naehrstoffe im Schnitt (grobe Schaetzung):")
+    if low:
+        lines.append(f"Eher wenig: {', '.join(low)}. (Schaetzung, kein Befund)")
+    return lines
+
+
+def rate_nutrients(m: dict) -> str:
+    """Zweite Sternzeile: Ballaststoffe, Obst/Gemuese und Mikronaehrstoffe, Abzug fuer Zucker, gesaettigtes Fett, Salz."""
+    n = nutrients(m)
+    kcal = max(int(m["kcal"]), 1)
+    if n is None or (kcal < 50 and n["veg_g"] < 50):
+        return ""  # Kaffee, Wasser usw. nicht bewerten
+    micros = m.get("micros")
+    micros = [str(x) for x in micros if x][:3] if isinstance(micros, list) else []
+    density = n["fiber_g"] / kcal * 1000
+    pts = 2 + (2 if density >= 14 else 1 if density >= 8 else 0)
+    pts += (2 if n["veg_g"] >= 150 else 1 if n["veg_g"] >= 75 else 0) + (1 if len(micros) >= 2 else 0)
+    notes = []
+    if n["sugar_g"] >= 5 and n["sugar_g"] * 4 / kcal > SUGAR_MAX_SHARE:
+        notes.append("viel zugesetzter Zucker")
+    if n["satfat_g"] >= 5 and n["satfat_g"] * 9 / kcal > 1.5 * SATFAT_MAX_SHARE:
+        notes.append("viel gesaettigtes Fett")
+    if n["salt_g"] > SALT_MAX * 0.45:
+        notes.append("sehr salzig")
+    stars = max(1, min(5, pts - len(notes)))
+    text = (f"Naehrstoffe: {'★' * stars}{'☆' * (5 - stars)} Ballaststoffe {n['fiber_g']:.0f} g, "
+            f"Obst/Gemuese {n['veg_g']:.0f} g")
+    if micros:
+        text += f", reich an {', '.join(micros)}"
+    return text + (f" – {', '.join(notes)}" if notes else "")
+
+
+def score_nutrients(t: dict) -> tuple[float, list[str]] | None:
+    """0-20 Punkte: Ballaststoffe 8, Obst/Gemuese 6, Zucker, gesaettigtes Fett und Salz je 2.
+    None, wenn der Tag Eintraege ohne Naehrstoffangaben enthaelt."""
+    if not t["n"] or t["nk"] < t["n"]:
+        return None
+    kcal = max(t["k"], 1)
+    pts = 8 * min(1, t["fiber"] / FIBER_GOAL) + 6 * min(1, t["veg"] / VEG_GOAL)
+    tips = []
+    if t["fiber"] < 0.7 * FIBER_GOAL:
+        tips.append(f"nur {t['fiber']:.0f} g Ballaststoffe (Ziel {FIBER_GOAL} g)")
+    if t["veg"] < 0.6 * VEG_GOAL:
+        tips.append(f"wenig Obst/Gemuese ({t['veg']:.0f} g, Ziel {VEG_GOAL} g)")
+    for value, limit, tip in (
+        (t["sugar"] * 4 / kcal, SUGAR_MAX_SHARE, "viel zugesetzter Zucker"),
+        (t["satfat"] * 9 / kcal, SATFAT_MAX_SHARE, "viel gesaettigtes Fett"),
+        (t["salt"], SALT_MAX, "viel Salz"),
+    ):
+        pts += 2 * max(0, 1 - max(0, value - limit) / limit)
+        if value > 1.3 * limit:
+            tips.append(tip)
+    return pts, tips
+
