[Unit]
Description=Agentenzentrale (Telegram-Bot für Jans Agenten-System)
# Bei Ausfall Meldung an Jan (shared/agentkit/ausfall.py)
OnFailure=ausfall@%n.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/agent/agenten/shared/telegram
ExecStart=/home/agent/agenten/shared/telegram/.venv/bin/python zentrale.py
Restart=on-failure
RestartSec=10
MemoryMax=300M

[Install]
WantedBy=default.target
