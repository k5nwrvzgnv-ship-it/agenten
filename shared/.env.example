# Vorlage für shared/.env. Echte Werte nur in shared/.env eintragen (chmod 600, nicht im Repo).

# Token des eigenen Telegram-Bots (von BotFather). Nicht den Token von kcalbot oder Vinted-Bot verwenden.
TELEGRAM_BOT_TOKEN=

# Jans Telegram-Chat-ID. Der Bot reagiert nur auf diese ID.
TELEGRAM_CHAT_ID=

# Höchstbetrag pro Kauf in Euro (nur nach Freigabe). Leer = Agenten kaufen nichts.
KAUF_LIMIT_EURO=
