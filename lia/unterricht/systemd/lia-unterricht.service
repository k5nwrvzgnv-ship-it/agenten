# Vorlage: nach ~/.config/systemd/user/lia-unterricht.service kopieren.
# Platzhalter-Agent für Lia. Lias Zentrale startet den Dienst nach jedem neuen Auftrag.
[Unit]
Description=Lias Agent unterricht (Platzhalter)
# Bei Ausfall Meldung an Jan (ausfall@ läuft ohne AGENTKIT_INSTANZ, also in Jans Instanz)
OnFailure=ausfall@%n.service

[Service]
Type=oneshot
Environment=AGENTKIT_INSTANZ=/home/agent/agenten/lia/shared
WorkingDirectory=/home/agent/agenten/lia/unterricht
ExecStart=/home/agent/agenten/lia/unterricht/.venv/bin/python agent.py
TimeoutStartSec=5min
MemoryMax=200M
